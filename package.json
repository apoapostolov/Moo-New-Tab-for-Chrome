{
  "name": "moo",
  "private": true,
  "author": "Apostol Apostolov (https://github.com/apoapostolov)",
  "description": "Fast, open and free-to-use new tab page for Firefox and Chrome.",
  "repository": {
    "url": "github:apoapostolov/Moo-New-Tab-for-Chrome"
  },
  "homepage": "https://github.com/apoapostolov/Moo-New-Tab-for-Chrome#readme",
  "bugs": "https://github.com/apoapostolov/Moo-New-Tab-for-Chrome/issues",
  "license": "BSD-3-Clause",
  "version": "1.0.0",
  "type": "module",
  "packageManager": "bun@1.3.1",
  "engines": {
    "node": ">=20.0.0",
    "bun": ">=1.3.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@eartharoid/i18n": "1.2.1",
    "@floating-ui/react-dom": "2.1.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/lexend-deca": "5.0.14",
    "blurhash": "^2.0.5",
    "dompurify": "^3.4.17",
    "fast-blurhash": "^1.1.4",
    "hls.js": "^1.7.3",
    "image-conversion": "^2.1.1",
    "marked": "^18.1.1",
    "react": "^19.2.3",
    "react-best-gradient-color-picker": "^3.0.14",
    "react-clock": "6.0.0",
    "react-dom": "^19.2.3",
    "react-icons": "^5.5.0",
    "react-modal": "3.16.3",
    "react-toastify": "11.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.3.1",
    "@commitlint/config-conventional": "^20.3.1",
    "@eartharoid/deep-merge": "^0.0.2",
    "@eslint/js": "^9.39.0",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "adm-zip": "0.5.17",
    "eslint": "^9.39.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "fake-indexeddb": "^6.2.6",
    "husky": "^9.1.7",
    "prettier": "^3.8.1",
    "sass": "^1.97.3",
    "stylelint": "^17.0.0",
    "stylelint-config-standard-scss": "^17.0.0",
    "stylelint-scss": "^7.0.0",
    "vite": "^7.3.1",
    "vite-plugin-progress": "^0.0.7"
  },
  "scripts": {
    "dev": "vite",
    "dev:host": "vite --host",
    "translations": "cd scripts && node updatetranslations.cjs",
    "translations:percentages": "node scripts/updateTranslationPercentages.cjs",
    "build": "vite build",
    "build:firefox": "node scripts/build-extensions.mjs firefox",
    "build:chrome": "node scripts/build-extensions.mjs chrome",
    "build:all": "node scripts/build-extensions.mjs all",
    "parity:check": "node scripts/sync-browsers.mjs --check",
    "pretty": "prettier --write \"./**/*.{js,jsx,json,scss,css}\"",
    "lint": "eslint \"./src/**/*.{js,jsx}\" --max-warnings 0 && stylelint \"./src/**/*.{scss,css}\"",
    "lint:fix": "eslint \"./src/**/*.{js,jsx}\" --fix && stylelint \"./src/**/*.{scss,css}\" --fix",
    "postinstall": "husky",
    "prepare": "husky",
    "test": "node --test tests/*.test.mjs",
    "test:memory": "node scripts/test-memory.mjs",
    "test:memory:chrome": "node scripts/test-memory.mjs --engine chrome",
    "test:memory:chrome:soak": "node scripts/test-memory.mjs --engine chrome --cycles 100 --soak-seconds 600",
    "test:memory:unit": "node --test tests/background-memory.test.mjs tests/background-storage-memory.test.mjs tests/memory-transport.test.mjs tests/chromium-memory-transport.test.mjs",
    "test:memory:soak": "node scripts/test-memory.mjs --cycles 100 --soak-seconds 600",
    "validate:firefox": "node scripts/validateFirefox.cjs",
    "validate:chrome": "node scripts/validateChrome.cjs"
  }
}
